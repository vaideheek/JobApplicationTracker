# JobTrack Backend Production Environment Variables

# The profile to use (set to 'prod' for production environments)
SPRING_PROFILES_ACTIVE=prod

# Port on which the Spring Boot application runs
PORT=8080

# Neon PostgreSQL connection parameters
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-subdomain>.neon.tech/<db-name>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>

# Initial Seeding of single-user Administrator
APP_ADMIN_EMAIL=admin@yourdomain.com
APP_ADMIN_PASSWORD=<secure-password-for-initial-setup>

# Allowed origins for CORS (comma-separated, e.g. Cloudflare Pages frontend origin)
APP_CORS_ALLOWED_ORIGINS=https://jobtrack-frontend.pages.dev

# Document Storage Provider configuration ('local' or 'r2')
APP_STORAGE_PROVIDER=r2

# Cloudflare R2 S3-Compatible Configuration (Required if APP_STORAGE_PROVIDER is r2)
R2_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<cloudflare-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<cloudflare-r2-secret-access-key>
R2_BUCKET_NAME=<cloudflare-r2-bucket-name>
R2_REGION=auto
